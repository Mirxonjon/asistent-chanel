# ---- NAMUNA FAYL ----
# Bu fayl git'ga tushadi - ICHIGA HAQIQIY KALIT YOZMANG.
# Haqiqiy qiymatlar .env faylida bo'ladi (u .gitignore da).
#   cp .env.example .env    keyin .env ni to'ldiring

# ---- Telegram ----
# @BotFather dan olinadi
BOT_TOKEN=123456789:AAE_bu_yerga_haqiqiy_token

# ---- OpenAI ----
OPENAI_API_KEY=sk-proj-bu_yerga_haqiqiy_kalit
# Arzon va tez. Mavjud modellarni ko'rish: npm run models
OPENAI_MODEL=gpt-6-luna

# ---- MongoDB ----
# Lokal:  mongodb://localhost:27017/postAi
# Atlas:  mongodb+srv://user:parol@cluster.mongodb.net/postAi
MONGODB_URI=mongodb://localhost:27017/postAi

# ---- Ixtiyoriy ----
# Faqat bot egasi uchun (/stats). Bo'sh qoldirsa ham bot ishlaydi.
OWNER_ID=
# Reja shu vaqt zonasi bo'yicha ishlaydi
DEFAULT_TIMEZONE=Asia/Tashkent
